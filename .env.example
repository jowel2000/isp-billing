# ------------------------------------------------------------------
# Database
# Dev default: SQLite. For production switch Prisma provider to
# "postgresql" and use a PostgreSQL URL.
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------
# Seed super admin
# ------------------------------------------------------------------
SEED_TENANT_CODE="TRG"
SEED_TENANT_NAME="JR COMMUNICATION"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_MOBILE="01700000000"
SEED_SUPER_ADMIN_LOGIN_ID="superadmin"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------
# Upstream Triangle panel (NEVER commit real values)
# ------------------------------------------------------------------
TRIANGLE_BASE_URL="https://lisp.triangle.com.bd"
TRIANGLE_USERNAME=""
TRIANGLE_PASSWORD=""

# Optional: Telegram OTP relay / alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Optional: auto-run upstream scrape/sync every 30 minutes
UPSTREAM_AUTO_SYNC="false"

# Android SMS forwarder / custom app -> POST /api/v1/webhooks/sms
# Send this value in the x-sms-secret header. Rejects fake SMS without it.
SMS_FORWARD_SECRET="change-this-sms-forward-secret"

# Auto-verify payments detected from SMS (super admin can override in Settings)
# sms_auto_verify_enabled=true
# sms_auto_verify_max_paisa=500000   # ৳5,000 cap per auto-verified payment

# ------------------------------------------------------------------
# Web
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
