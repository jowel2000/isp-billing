# ------------------------------------------------------------------
# Database
# Dev default: SQLite. For production switch Prisma provider to
# "postgresql" and use a PostgreSQL URL.
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT (CHANGE THESE IN PRODUCTION)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ------------------------------------------------------------------
# Seed super admin
# ------------------------------------------------------------------
SEED_TENANT_CODE="TRG"
SEED_TENANT_NAME="JR COMMUNICATION"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_MOBILE="01700000000"
SEED_SUPER_ADMIN_LOGIN_ID="superadmin"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------
# Upstream Triangle panel (NEVER commit real values)
# ------------------------------------------------------------------
TRIANGLE_BASE_URL="https://lisp.triangle.com.bd"
TRIANGLE_USERNAME=""
TRIANGLE_PASSWORD=""

# Login strategy: http = plain fetch (default), browser = Playwright/Chromium,
# auto = browser fallback when the HTTP login is rejected by the panel.
TRIANGLE_LOGIN_MODE="http"
PLAYWRIGHT_HEADLESS="true"

# Optional: Telegram OTP relay / alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Optional: auto-run upstream scrape/sync (default 4x daily = every 360 min)
UPSTREAM_AUTO_SYNC="false"
UPSTREAM_AUTO_SYNC_INTERVAL_MINUTES="360"

# Minimum wait between new upstream login/OTP requests (default 5 minutes)
UPSTREAM_LOGIN_COOLDOWN_MINUTES="5"

# Optional: run upstream scrape/sync at fixed times (comma-separated HH:MM, 24h).
# Example "08:00,20:00" = twice a day. Empty (default) disables this scheduler.
UPSTREAM_SYNC_TIMES=""
# Optional timezone for UPSTREAM_SYNC_TIMES, e.g. Asia/Dhaka. Empty = process local time.
UPSTREAM_SYNC_TZ=""

# Android SMS forwarder / custom app -> POST /api/v1/webhooks/sms
# Send this value in the x-sms-secret header. Rejects fake SMS without it.
SMS_FORWARD_SECRET="change-this-sms-forward-secret"

# ------------------------------------------------------------------
# AI SMS classifier (optional; deterministic parser is the fallback)
# ------------------------------------------------------------------
AI_CLASSIFIER_ENABLED="true"
# gemini | openai | deepseek | opencode-go | opencode | none
AI_PROVIDER="gemini"
AI_API_KEY=""
# AI_MODEL="gemini-2.0-flash"
# AI_BASE_URL=""
# AI_MIN_CONFIDENCE=0.65
# AI_TIMEOUT_MS=5000
# UPSTREAM_PANEL_NAME="Triangle"

# OpenCode Go / pay-as-you-go:
# AI_PROVIDER="opencode-go"          # or "opencode"
# AI_API_KEY="oc_sk_..."
# AI_MODEL="<model id from /v1/models>"
# AI_OPENCODE_SESSION="ses_isp_sms_classifier"
# AI_USER_AGENT="JR-Communication-SMS-AI/1.0"

# Auto-verify payments detected from SMS (super admin can override in Settings)
# sms_auto_verify_enabled=true
# sms_auto_verify_max_paisa=500000   # ৳5,000 cap per auto-verified payment

# ------------------------------------------------------------------
# Web
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
